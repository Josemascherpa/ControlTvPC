{
  // El Cine (la app, en ui/js/web/cine) y el script que le agrega la notebook (ui/js/web/inject.js).
  // Compila también shared/ (lo comparte con el servicio): la salida queda en ui/js/web y ui/js/shared.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "outDir": "../ui/js",
    "types": [],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "../shared/**/*.ts"]
}
