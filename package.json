{
  "name": "controltv-pc",
  "version": "2.0.0",
  "private": true,
  "description": "ControlTv PC: convierte la notebook en una Smart TV manejada desde el celular",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "koffi": "2.9.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  }
}
