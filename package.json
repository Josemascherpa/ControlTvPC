{
  "name": "controltv-pc",
  "version": "2.0.0",
  "private": true,
  "description": "ControlTv PC: convierte la notebook en una Smart TV manejada desde el celular",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build:typescript && npm run build:native",
    "build:typescript": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File native/build-native.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "npm run build:typescript && node --test tests/*.test.cjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "koffi": "2.9.0",
    "undici": "6.21.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  }
}
