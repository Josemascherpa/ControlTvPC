{
  "name": "controltv-pc",
  "version": "2.0.0",
  "private": true,
  "description": "ControlTv PC: la notebook como tele con el Cine, manejada desde el celular",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "npm run build:typescript && npm run build:native",
    "build:typescript": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && npm run build:vendor",
    "build:vendor": "node -e \"require('fs').mkdirSync('ui/vendor',{recursive:true});require('fs').copyFileSync('node_modules/hls.js/dist/hls.min.js','ui/vendor/hls.js')\"",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File native/build-native.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "npm run build:typescript && node --test tests/*.test.cjs",
    "apk": "powershell -NoProfile -ExecutionPolicy Bypass -File android/compilar-apk.ps1",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "koffi": "2.9.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  }
}
